{
  "name": "nect-svg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:regression": "node scripts/regression-runner.mjs",
    "check:native-build": "node scripts/check-native-build-config.mjs",
    "test:e2e": "npm run test:csp && node scripts/browser-suite-runner.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "desktop:dev": "npx @tauri-apps/cli@2 dev",
    "desktop:build": "npx @tauri-apps/cli@2 build",
    "test:csp": "npm run build && node tests/production-csp.e2e.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "clipper2-ts": "2.0.1-18",
    "fontkit": "2.0.4",
    "opentype.js": "1.3.4",
    "pako": "3.0.2",
    "paper": "0.12.18"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "playwright-core": "1.56.1",
    "prettier": "^3.6.2",
    "vite": "7.3.7"
  }
}
